{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sync-claude-md.sh",
            "timeout": 120,
            "statusMessage": "Checking if CLAUDE.md needs updating..."
          }
        ]
      }
    ]
  }
}
